{
  "name": "websocket-serverless",
  "version": "1.0.0",
  "description": "100% Serverless Pusher-compatible WebSocket Server built for Cloudflare Workers and Durable Objects",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/ tests/",
    "format": "biome check --write src/ tests/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ]
  },
  "keywords": [
    "pusher",
    "websocket",
    "serverless",
    "cloudflare-workers",
    "durable-objects",
    "realtime",
    "pubsub",
    "websockets"
  ],
  "author": "Maximiliano Contartesi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcontartesi/websocket-serverless.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "semantic-release": "^25.0.8",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "hono": "^4.12.33"
  }
}
